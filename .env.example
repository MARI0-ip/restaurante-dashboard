# Puerto donde corre el servidor
PORT=3001

# Nombre del restaurante (aparece en el dashboard)
NOMBRE_RESTAURANTE=Mi Restaurante

# Webhook de n8n al que enviar actualizaciones de estado
# (lo configuras cuando tengas la URL de n8n)
N8N_WEBHOOK_ESTADO=https://tu-n8n.com/webhook/estado-pedido

# Token de seguridad para que solo n8n pueda enviar pedidos (opcional)
# Si lo defines, n8n debe enviar el header: Authorization: Bearer TU_TOKEN
WEBHOOK_SECRET=
